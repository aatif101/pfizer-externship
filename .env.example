# SQLite database path
DB_PATH=compliance.db

# HuggingFace model cache (set to Drive path in Colab: /content/drive/MyDrive/hf_cache)
HF_HOME=~/.cache/huggingface

# Langfuse observability (v3 — do NOT upgrade to v4)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# Safety limits
MAX_PDF_MB=100

# Claude faithfulness critic (Phase 6). Leave empty to make the agentic critic abstain (fail closed).
ANTHROPIC_API_KEY=
# Critic provider: anthropic (default) or gemini (explicit opt-in only, no automatic fallback)
CRITIC_PROVIDER=anthropic
# Critic model id
CRITIC_MODEL=claude-sonnet-4-6
# Minimum critic faithfulness score (0..1) required to accept a drafted answer
CRITIC_MIN_FAITHFULNESS=0.8

# Chat pipeline: agentic (phase2, LangGraph) or linear (phase1 baseline)
RAG_PIPELINE=agentic
# Langfuse phase tag for non-RAG entry points (CLIs, review)
PIPELINE_PHASE=phase2
