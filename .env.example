# SQLite database path
DB_PATH=compliance.db

# HuggingFace model cache (set to Drive path in Colab: /content/drive/MyDrive/hf_cache)
HF_HOME=~/.cache/huggingface

# Langfuse observability (v3 — do NOT upgrade to v4)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# Safety limits
MAX_PDF_MB=100